{
  "_comment": "Smoke test config - runs in <1 minute for CI/CD",

  "model": {
    "dropout_prob": 0.0,
    "num_blocks": 2,
    "emb_dim": 128,
    "num_heads": 2,
    "seq_len": 128,
    "vocab_size": 1024
  },

  "optimizer": {
    "learning_rate": 1e-3,
    "use_lr_schedule": false,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "weight_decay": 0.0
  },

  "training": {
    "max_steps": 10,
    "micro_batch_size": 2,
    "gradient_accumulation_steps": 1,
    "seed": 42
  },

  "data": {
    "dataloader_class": "DummyDataLoader"
  },

  "logging": {
    "eval_interval": 5,
    "eval_iters": 2,
    "log_interval": 2
  },

  "checkpointing": {
    "save_interval": 10,
    "output_dir": "output_smoke",
    "resume_from_checkpoint": null
  },

  "wandb": {
    "enabled": false,
    "project": "janogpt",
    "run_name": "smoke-test"
  }
}
