{
  "_comment": "Full GPT-2 124M training config for GPU cluster (8x A100 or similar)",
  "_description": "Production training run to 600K steps with 0.5M tokens per step",

  "model": {
    "dropout_prob": 0.1,
    "num_blocks": 12,
    "emb_dim": 768,
    "num_heads": 12,
    "seq_len": 1024,
    "epsilon": 1e-6,
    "voc_size": 50304
  },

  "optimizer": {
    "learning_rate": 6e-4,
    "min_learning_rate": 6e-5,
    "warmup_steps": 2000,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "weight_decay": 0.1
  },

  "training": {
    "max_steps": 600000,
    "micro_batch_size": 4,
    "gradient_accumulation_steps": 16,
    "_effective_batch_comment": "4 × 16 × 8 GPUs × 1024 = 524,288 tokens per step ≈ 0.5M",
    "seed": 42
  },

  "data": {
    "data_dir": "data/openwebtext",
    "train_file": "train.bin",
    "val_file": "val.bin"
  },

  "logging": {
    "eval_interval": 1000,
    "eval_iters": 200,
    "log_interval": 10
  },

  "checkpointing": {
    "save_interval": 5000,
    "output_dir": "output_gpt2_full",
    "resume_from_checkpoint": null
  },

  "wandb": {
    "enabled": true,
    "project": "janogpt",
    "run_name": null,
    "entity": null,
    "tags": ["gpt2", "full-training", "600k-steps"]
  },

  "hardware": {
    "_comment": "Target hardware specification",
    "target_device": "gpu",
    "expected_devices": 8,
    "memory_per_device_gb": 80
  }
}
