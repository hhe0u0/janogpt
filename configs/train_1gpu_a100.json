{
  "_comment": "GPT-2 124M training config for single A100 GPU",
  "_description": "Medium-scale training on single GPU with gradient accumulation",

  "model": {
    "dropout_prob": 0.1,
    "num_blocks": 12,
    "emb_dim": 768,
    "num_heads": 12,
    "seq_len": 1024,
    "epsilon": 1e-6,
    "vocab_size": 50304
  },

  "optimizer": {
    "learning_rate": 6e-4,
    "min_learning_rate": 6e-5,
    "warmup_steps": 2000,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "weight_decay": 0.1
  },

  "training": {
    "max_steps": 100000,
    "micro_batch_size": 4,
    "gradient_accumulation_steps": 128,
    "_effective_batch_comment": "4 × 128 × 1024 = 524,288 tokens per step ≈ 0.5M",
    "seed": 42
  },

  "data": {
    "data_dir": "data/openwebtext",
    "train_file": "train.bin",
    "val_file": "val.bin"
  },

  "logging": {
    "eval_interval": 500,
    "eval_iters": 100,
    "log_interval": 10
  },

  "checkpointing": {
    "save_interval": 2000,
    "output_dir": "output_1gpu",
    "resume_from_checkpoint": null
  },

  "wandb": {
    "enabled": true,
    "project": "janogpt",
    "run_name": null,
    "entity": null,
    "tags": ["gpt2", "1gpu", "a100"]
  },

  "hardware": {
    "_comment": "Target hardware specification",
    "target_device": "gpu",
    "expected_devices": 1,
    "memory_per_device_gb": 40
  }
}
