{
  "_comment": "Small config for integration tests",

  "model": {
    "dropout_prob": 0.0,
    "num_blocks": 4,
    "emb_dim": 128,
    "num_heads": 4,
    "seq_len": 128,
    "vocab_size": 512
  },

  "optimizer": {
    "learning_rate": 3e-4,
    "use_lr_schedule": true,
    "warmup_steps": 10,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "weight_decay": 0.01
  },

  "training": {
    "max_steps": 20,
    "micro_batch_size": 4,
    "gradient_accumulation_steps": 2,
    "seed": 42
  },

  "data": {
    "dataloader_class": "DummyDataLoader"
  },

  "logging": {
    "eval_interval": 10,
    "eval_iters": 5,
    "log_interval": 5
  },

  "checkpointing": {
    "save_interval": 10,
    "output_dir": "output_test_small",
    "resume_from_checkpoint": null
  },

  "wandb": {
    "enabled": false,
    "project": "janogpt-test",
    "run_name": "test-small"
  }
}
